# SQLite locally (path is relative to the prisma/ folder).
# Production: set provider = "postgresql" in prisma/schema.prisma
# and use a Postgres URL. The Dockerfile does this when DATABASE_PROVIDER=postgresql.
DATABASE_URL="file:./dev.db"

# Signs the session cookie. Use a long random value in production.
SESSION_SECRET="change-me-in-production"

# Household location used on price observations. Laval, QC.
DEFAULT_POSTAL_CODE="H7T2P1"

# Optional OpenAI-compatible chat API.
# When set, recipe pages that publish no structured data and receipt photos
# can be read by the model. Without a key, JSON-LD, microdata, recipe-scrapers
# and the built-in receipt parser still work.
RECEIPT_AI_API_KEY=
RECEIPT_AI_BASE_URL=https://api.openai.com/v1
RECEIPT_AI_MODEL=gpt-4o-mini

# Per-store kill switch. Set to "off" to skip that adapter entirely.
STORE_MAXI=on
STORE_PROVIGO=on
STORE_IGA=on
STORE_METRO=on
STORE_SUPERC=on
STORE_WALMART=on
STORE_COSTCO=on

# Minimum delay between HTTP requests to the same store, in milliseconds.
SCRAPE_DELAY_MS=3000

# Reserved. Current adapters use plain HTTP only. A browser is not used to
# retry a 403, a captcha, or a client-rendered shell. Leave this at 0.
SCRAPE_BROWSER=0

# Optional Python used for the recipe-scrapers fallback.
RECIPE_SCRAPER_PYTHON=python3
